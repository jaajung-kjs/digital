# Database Configuration
DB_USER=postgres
DB_PASSWORD=postgres123
# 재구축(Stage 7) 이후 v2 는 digital_next 단일 DB 를 쓴다. compose 가 이 값을
# POSTGRES_DB 와 DATABASE_URL_NEXT 양쪽에 넣는다.
DB_NAME=digital_next
DB_PORT=5432

# JWT Configuration
JWT_ACCESS_SECRET=your-access-secret-key-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Port Configuration
BACKEND_PORT=3000
# 80 이 아니다 — nginx 가 비루트로 실행돼 컨테이너 안에서 8080 을 열고,
# 사내망 DPI 도 80 트래픽을 막는다.
FRONTEND_PORT=8080

# 백엔드 CORS 허용 출처 — 프론트를 실제로 접속하는 주소와 일치해야 한다.
CORS_ORIGIN=http://localhost:8080
