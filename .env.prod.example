# Production .env template — copy to .env on the air-gapped server before
# `podman-compose -f docker-compose.prod.yml up -d`.
#
# All JWT_* / DB_PASSWORD / CORS_ORIGIN values MUST be replaced with
# real production values. Generate JWT secrets with e.g.
#   openssl rand -hex 32

# ── Database ────────────────────────────────────────────────────
DB_USER=postgres
DB_PASSWORD=__CHANGE_ME_STRONG_DB_PASSWORD__
# 재구축(Stage 7) 이후 v2 는 digital_next 단일 DB 를 쓴다. compose 가 이 값을
# POSTGRES_DB 와 DATABASE_URL_NEXT 양쪽에 넣으므로, 옛 이름(ict_digital_twin)을
# 두면 백엔드가 구 레거시 DB 를 가리키게 되고 그 DB 에 구 스키마가 남아 있으면
# `prisma migrate deploy` 가 P3005(스키마가 비어있지 않음)로 실패한다.
DB_NAME=digital_next

# ── JWT (32+ random hex chars each) ─────────────────────────────
JWT_ACCESS_SECRET=__CHANGE_ME_LONG_RANDOM_HEX__
JWT_REFRESH_SECRET=__CHANGE_ME_LONG_RANDOM_HEX_DIFFERENT__
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# ── Network ─────────────────────────────────────────────────────
# Frontend (nginx) is the only externally exposed port.
#
# IMPORTANT: stay on a non-80 port on K-Cloud. The corporate network's
# DPI/WAF deeply inspects port 80 traffic per-source-IP and silently drops
# new SYNs once a browser has 6 keep-alive connections open — symptoms
# look like "host frozen + ssh abort" but are actually upstream packet
# drops. 8080 / 8443 / 8888 etc. are not subject to that policy.
FRONTEND_PORT=8080

# Origin allowed by backend CORS — set to whatever URL the user types
# in the browser, including the port.
# Example: http://100.1.223.191:8080
CORS_ORIGIN=http://localhost:8080
