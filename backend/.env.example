# Database (digital_next — v2 단일 스키마)
DATABASE_URL_NEXT="postgresql://postgres:postgres123@localhost:5432/digital_next"

# JWT
JWT_ACCESS_SECRET="your-access-secret-key-change-in-production"
JWT_REFRESH_SECRET="your-refresh-secret-key-change-in-production"
JWT_ACCESS_EXPIRES_IN="1h"
JWT_REFRESH_EXPIRES_IN="7d"

# Server
PORT=3000
NODE_ENV=development

# CORS
CORS_ORIGIN="http://localhost:5173"

# Security
BCRYPT_ROUNDS=10

# 자산 사진 저장 루트(절대 경로). 미설정 시 개발 기본값은 backend/uploads.
# 컨테이너에서는 compose 가 /app/uploads 로 주입한다 — 볼륨 마운트 지점과 반드시 일치해야 한다.
UPLOADS_DIR=
