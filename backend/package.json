{
  "name": "ict-digital-twin-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "rm -rf dist && tsc && cp -R src/generated dist/generated",
    "start": "node dist/index.js",
    "lint": "eslint . --ext ts --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "db:next:generate": "prisma generate --schema prisma/next/schema.prisma",
    "db:next:migrate": "prisma migrate dev --schema prisma/next/schema.prisma",
    "db:next:migrate:prod": "prisma migrate deploy --schema prisma/next/schema.prisma",
    "db:next:seed": "tsx prisma/next/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@twin/core": "*",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.9.0",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.11.0",
    "@typescript-eslint/parser": "^8.11.0",
    "@vitest/coverage-v8": "^4.0.15",
    "@vitest/ui": "^4.0.15",
    "c8": "^10.1.3",
    "eslint": "^9.13.0",
    "supertest": "^7.1.4",
    "typescript": "^5.6.3",
    "vitest": "^4.0.15"
  }
}
