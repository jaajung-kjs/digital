generator client {
  provider = "prisma-client-js"
  output   = "../../src/generated/next-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL_NEXT")
}

// ---------- 조직/공간 (구 모델 유지) ----------

model User {
  id               String         @id @default(uuid())
  username         String         @unique
  passwordHash     String
  role             String         @default("viewer") // 'admin' | 'viewer'
  // 로그인 시도 제한 — 없으면 계정 열거 이후 무제한 대입으로 바로 이어진다.
  failedLoginCount Int            @default(0)
  lockedUntil      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  refreshTokens    RefreshToken[]
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Headquarters {
  id        String   @id @default(uuid())
  name      String   @unique
  sortOrder Int      @default(0)
  branches  Branch[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Branch {
  id             String       @id @default(uuid())
  name           String
  sortOrder      Int          @default(0)
  headquartersId String
  headquarters   Headquarters @relation(fields: [headquartersId], references: [id])
  substations    Substation[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([headquartersId, name])
}

model Substation {
  id        String      @id @default(uuid())
  name      String      @unique
  sortOrder Int         @default(0)
  branchId  String
  branch    Branch      @relation(fields: [branchId], references: [id])
  floors    Floor[]
  racks     Rack[]
  equipment Equipment[]
  links     Link[]
  linesA    FiberLine[] @relation("LineA")
  linesB    FiberLine[] @relation("LineB")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model Floor {
  id                String     @id @default(uuid())
  name              String
  sortOrder         Int        @default(0)
  substationId      String
  substation        Substation @relation(fields: [substationId], references: [id])
  backgroundDrawing Json?
  backgroundOpacity Float      @default(0.5)
  racks             Rack[]
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@unique([substationId, name])
}

// ---------- 마스터 (관리자가 정의) ----------

/// 분야 — 현황이 묶는 단위.
model Category {
  id        String          @id @default(uuid())
  key       String          @unique
  name      String
  sortOrder Int             @default(0)
  types     EquipmentType[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model RackType {
  id              String   @id @default(uuid())
  key             String   @unique
  name            String
  sortOrder       Int      @default(0)
  laborCode       String?
  unitPrice       Int?
  installManDays  Float?
  removeManDays   Float?
  relocateManDays Float?
  racks           Rack[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model EquipmentType {
  id              String      @id @default(uuid())
  key             String      @unique
  name            String
  categoryId      String
  category        Category    @relation(fields: [categoryId], references: [id])
  sortOrder       Int         @default(0)
  laborCode       String?
  unitPrice       Int?
  installManDays  Float?
  removeManDays   Float?
  relocateManDays Float?
  equipment       Equipment[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

/// 케이블 종류 — 매체는 `CABLE_MEDIA` 의 키(power|comm|ground|fiber). 품셈은 m 당.
model CableType {
  id             String      @id @default(uuid())
  key            String      @unique
  name           String
  medium         String
  sortOrder      Int         @default(0)
  laborCode      String?
  unitPrice      Int?
  installManDays Float?
  removeManDays  Float?
  links          Link[]
  lines          FiberLine[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

// ---------- 현장 (국 → 랙 → 설비) ----------

model Rack {
  id           String      @id @default(uuid())
  substationId String
  substation   Substation  @relation(fields: [substationId], references: [id])
  name         String
  rackTypeId   String
  rackType     RackType    @relation(fields: [rackTypeId], references: [id])
  floorId      String?
  floor        Floor?      @relation(fields: [floorId], references: [id])
  x            Float?
  y            Float?
  width        Float?
  height       Float?
  facing       String?
  equipment    Equipment[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([substationId, name])
  @@index([floorId])
}

model Equipment {
  id           String           @id @default(uuid())
  substationId String
  substation   Substation       @relation(fields: [substationId], references: [id])
  rackId       String
  rack         Rack             @relation(fields: [rackId], references: [id], onDelete: Restrict)
  name         String
  typeId       String
  type         EquipmentType    @relation(fields: [typeId], references: [id])
  status       String           @default("normal")
  model        String?
  maker        String?
  madeOn       String?
  serial       String?
  installDate  DateTime?        @db.Date
  manager      String?
  note         String?
  circuitCount Int              @default(0)
  panelCount   Int?
  circuits     Circuit[]
  linkEnds     LinkEnd[]
  linesA       FiberLine[]      @relation("LineAEquipment")
  linesB       FiberLine[]      @relation("LineBEquipment")
  maintenance  MaintenanceLog[]
  inspections  InspectionLog[]
  photos       EquipmentPhoto[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([substationId, name])
  @@index([rackId])
}

/// 회로 — 공급 설비의 번호 행. 자연 키 (equipmentId, no).
model Circuit {
  equipmentId String
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  no          Int
  label       String?
  current     String?
  voltage     String?
  capacity    String?
  phase       String?
  switch      String?
  purpose     String?
  linkEnds    LinkEnd[]
  updatedAt   DateTime  @updatedAt

  @@id([equipmentId, no])
}

/// 광선로 — 두 끝(국·단자 설비·판·시작번호). 끝의 국은 만든 뒤 바꾸지 않는다.
model FiberLine {
  id            String     @id @default(uuid())
  cableTypeId   String
  cableType     CableType  @relation(fields: [cableTypeId], references: [id])
  coreCount     Int
  name          String?
  lengthKm      Float?
  segments      Json       @default("[]")
  aSubstationId String
  aSubstation   Substation @relation("LineA", fields: [aSubstationId], references: [id])
  aEquipmentId  String?
  aEquipment    Equipment? @relation("LineAEquipment", fields: [aEquipmentId], references: [id], onDelete: SetNull)
  aPanel        Int?
  aStartNo      Int        @default(1)
  bSubstationId String
  bSubstation   Substation @relation("LineB", fields: [bSubstationId], references: [id])
  bEquipmentId  String?
  bEquipment    Equipment? @relation("LineBEquipment", fields: [bEquipmentId], references: [id], onDelete: SetNull)
  bPanel        Int?
  bStartNo      Int        @default(1)
  cores         Core[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([aSubstationId])
  @@index([bSubstationId])
}

/// 코어 — 광선로의 번호 행. 자연 키 (lineId, no). 「사용 중」은 저장하지 않는다.
model Core {
  lineId       String
  line         FiberLine         @relation(fields: [lineId], references: [id], onDelete: Cascade)
  no           Int
  status       String            @default("ok")
  role         String?
  /// 용도·비고는 끝별 — 현장 선번장은 국마다 제 쪽에서 적는다(Tx/Rx·EAST/WEST 가 끝마다 다르다).
  aPurpose     String?
  aNote        String?
  bPurpose     String?
  bNote        String?
  measurements CoreMeasurement[]
  linkEnds     LinkEnd[]
  updatedAt    DateTime          @updatedAt

  @@id([lineId, no])
}

model CoreMeasurement {
  id         String    @id @default(uuid())
  lineId     String
  coreNo     Int
  core       Core      @relation(fields: [lineId, coreNo], references: [lineId, no], onDelete: Cascade)
  measuredOn DateTime? @db.Date
  side       String
  loss1310   Float?
  dist1310   Float?
  loss1550   Float?
  dist1550   Float?
  measuredBy String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([lineId, coreNo])
}

/// 국 내 연결 — 국 안의 물리 케이블. 끝은 LinkEnd 둘.
model Link {
  id           String     @id @default(uuid())
  substationId String
  substation   Substation @relation(fields: [substationId], references: [id])
  cableTypeId  String?
  cableType    CableType? @relation(fields: [cableTypeId], references: [id])
  lengthM      Float?
  spec         String?
  note         String?
  pathPoints   Json       @default("[]")
  ends         LinkEnd[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([substationId])
}

/// 연결의 한 끝 — 설비(+표기) | 회로 | 코어 끝 중 정확히 하나(마이그레이션의 CHECK).
/// 회로 끝·코어 끝은 유일(NULL 은 서로 다르므로 일반 유일 제약으로 충분하다).
/// 대상 쪽 삭제는 **Restrict** — 연결을 함께 지우는 것은 클라이언트의 삭제 펼침이 한다.
model LinkEnd {
  id                 String     @id @default(uuid())
  linkId             String
  link               Link       @relation(fields: [linkId], references: [id], onDelete: Cascade)
  end                String
  equipmentId        String?
  equipment          Equipment? @relation(fields: [equipmentId], references: [id], onDelete: Restrict)
  label              String?
  circuitEquipmentId String?
  circuitNo          Int?
  circuit            Circuit?   @relation(fields: [circuitEquipmentId, circuitNo], references: [equipmentId, no], onDelete: Restrict)
  coreLineId         String?
  coreNo             Int?
  coreSide           String?
  core               Core?      @relation(fields: [coreLineId, coreNo], references: [lineId, no], onDelete: Restrict)

  @@unique([linkId, end])
  @@unique([circuitEquipmentId, circuitNo])
  @@unique([coreLineId, coreNo, coreSide])
  @@index([equipmentId])
}

/// 커밋 한 번 = 한 줄. 누가·언제·무엇을(행별 전/후).
model ChangeLog {
  id       String   @id @default(uuid())
  userId   String
  username String
  at       DateTime @default(now())
  summary  Json
}

model MaintenanceLog {
  id          String    @id @default(uuid())
  equipmentId String
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  occurredAt  DateTime
  content     String
  action      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([equipmentId])
}

model InspectionLog {
  id          String    @id @default(uuid())
  equipmentId String
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  inspectedAt DateTime
  content     String
  result      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([equipmentId])
}

model EquipmentPhoto {
  id          String    @id @default(uuid())
  equipmentId String
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  filePath    String
  caption     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([equipmentId])
}

/// 올려도 이전 판은 지우지 않고, 「적용 중」 하나만 갈아 끼운다.
///
/// 카탈로그는 이 판을 가리키지 않는다 — **직종 코드**만 들고 있고 단가는 적용 중인 판에서
/// 읽는다. 그래서 판을 갈아도 카탈로그를 손댈 일이 없다.
model LaborStandard {
  id         String   @id @default(uuid())
  /// 무엇의 기준인가 — 'wage'(직종 노임단가). 'overhead'(제비율)가 이어 붙는다.
  kind       String
  /// 사람이 읽는 적용시기 — 「2026년도 상반기」.
  effective  String
  /// 올린 파일 이름 — 어느 문서에서 왔는지 되짚을 수 있게.
  sourceName String
  /// 파싱 결과. `kind` 마다 모양이 다르다(wage: { dates, rows }).
  payload    Json
  /// 지금 적용 중인 판인가 — `kind` 당 하나만 true.
  active     Boolean  @default(false)
  uploadedBy String
  createdAt  DateTime @default(now())

  @@index([kind, active])
}

/// 직종 노임 한 칸 — **(직종 코드 × 기준일)** 하나에 값 하나.
///
/// 왜 표를 통째로 스냅샷 뜨지 않고 칸으로 쪼개나: 보고서는 한 번에 네 회차를 준다. 그중
/// 어떤 칸은 비어 있는데(그 반기에 조사되지 않은 직종), 스냅샷으로 최신 열만 담으면
/// 「비었으면 이전 걸 쓰자」는 판단을 코드가 해야 한다. 있는 값만 행으로 넣어 두면
/// 「현재 단가」는 **그 직종의 가장 최근 행**일 뿐이라 판단할 것이 없다.
///
/// 값이 없는 칸은 행을 만들지 않는다 — 없는 것은 없는 것이지 null 이 아니다.
model LaborRate {
  /// 조사 코드. 이름이 바뀌어도 이것으로 잇는다.
  code           String
  /// 정렬·비교용 기준일.
  effectiveOn    DateTime
  /// 화면에 적는 기준일 — 보고서 표기 그대로(「2026.1.1」).
  effectiveLabel String
  /// 그 회차의 직종 이름 — 이름이 바뀌면 이력으로 남는다.
  name           String
  sector         String
  /// 원/일.
  wage           Int
  /// 그 회차의 각주 표시(`*`·`**`).
  marker         String   @default("")
  /// 그 표시의 뜻 — **그 회차 보고서의 문장 그대로**.
  ///
  /// 판에 두지 않고 행에 붙이는 이유: 옛 회차 값을 보여 줄 때 각주도 그 회차의 것이어야
  /// 한다. 보고서가 문구를 바꾸면 판에서 읽던 설명이 값과 어긋난다.
  markerNote     String?
  /// 어느 임포트에서 왔나 — 되짚기용(LaborStandard.id).
  sourceId       String
  createdAt      DateTime @default(now())

  @@id([code, effectiveOn])
  @@index([code, effectiveOn])
}
