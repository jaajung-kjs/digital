generator client {
  provider = "prisma-client-js"
  output   = "../../src/generated/next-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL_NEXT")
}

// ---------- 조직/공간 (구 모델 유지) ----------

model User {
  id             String         @id @default(uuid())
  username       String         @unique
  passwordHash   String
  role           String         @default("viewer") // 'admin' | 'viewer'
  // 로그인 시도 제한 — 없으면 계정 열거 이후 무제한 대입으로 바로 이어진다.
  failedLoginCount Int          @default(0)
  lockedUntil      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  refreshTokens  RefreshToken[]
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Headquarters {
  id        String   @id @default(uuid())
  name      String   @unique
  sortOrder Int      @default(0)
  branches  Branch[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Branch {
  id             String       @id @default(uuid())
  name           String
  sortOrder      Int          @default(0)
  headquartersId String
  headquarters   Headquarters @relation(fields: [headquartersId], references: [id])
  substations    Substation[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([headquartersId, name])
}

model Substation {
  id        String   @id @default(uuid())
  name      String   @unique
  sortOrder Int      @default(0)
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id])
  floors    Floor[]
  assets    Asset[]
  cables    Cable[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Floor {
  id                String     @id @default(uuid())
  name              String
  sortOrder         Int        @default(0)
  substationId      String
  substation        Substation @relation(fields: [substationId], references: [id])
  backgroundDrawing Json?
  backgroundOpacity Float      @default(0.5)
  assets            Asset[]
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@unique([substationId, name])
}

// ---------- 카탈로그 (타입 정의 = 데이터) ----------

model AssetCategory {
  id        String      @id @default(uuid())
  key       String      @unique
  name      String
  sortOrder Int         @default(0)
  types     AssetType[]
  assemblies Assembly[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model AssetType {
  id             String              @id @default(uuid())
  key            String              @unique
  name           String
  categoryId     String
  category       AssetCategory       @relation(fields: [categoryId], references: [id])
  sortOrder      Int                 @default(0)
  isActive       Boolean             @default(true)
  // 배치 명세
  placeable      Boolean             @default(false)
  defaultWidth   Float?
  defaultHeight  Float?
  // 공량 규칙
  laborType      String?
  installHours   Float               @default(0)
  removeHours    Float               @default(0)
  relocateHours  Float               @default(0)
  portTemplates  AssetPortTemplate[]
  assets         Asset[]
  assemblyItems  AssemblyItem[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
}

model AssetPortTemplate {
  id          String    @id @default(uuid())
  typeId      String
  type        AssetType @relation(fields: [typeId], references: [id], onDelete: Cascade)
  group       String
  count       Int
  direction   String // 'IN' | 'OUT' | 'BI'
  medium      String
  namePattern String
  /// 이 포트 하나가 나르는 심선 수. 1 = 보통 포트, N = 다심 포트(OPGW 인입).
  positions   Int       @default(1)
  sortOrder   Int       @default(0)

  @@unique([typeId, group])
}

// ---------- 설비 형판 (부품 조립) ----------

/// 부품을 조립해 만든 **한 설비**의 형판 — 「송변전광단말장치 1식」 같은 표준 구성.
///
/// 자산 타입이 곧 도면에 놓이는 것이면, 랙을 만들고 자리를 세고 장비를 넣는 일을 매번
/// 손으로 해야 하고 현황에도 그 부산물이 다 올라온다. 형판은 그 조립을 한 번 해 두고
/// 계속 쓰기 위한 것이다.
model Assembly {
  id         String         @id @default(uuid())
  key        String         @unique
  name       String
  categoryId String?
  category   AssetCategory? @relation(fields: [categoryId], references: [id])
  /// 이 설비 안의 **격자** — 부품을 놓을 자리다.
  ///
  /// 예전에는 자리를 자산 타입이 선언했고(랙의 「슬롯 12칸」), 그래서 담기 위한 랙이라는
  /// 자산이 따로 있어야 했다. 슬롯은 사실 폭이 격자 전체인 1열짜리 격자였을 뿐이라,
  /// 격자를 형판이 직접 가지면 그 층이 통째로 사라진다.
  gridCols   Int            @default(1)
  gridRows   Int            @default(12)
  sortOrder  Int            @default(0)
  isActive   Boolean        @default(true)
  items      AssemblyItem[]
  assets     Asset[]
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
}

/// 형판 격자에 놓인 부품 하나 — 어느 타입을, 격자의 어느 자리에.
///
/// **평평하다.** 부품이 또 부품을 담지 않는다 — 담는 일은 형판 격자가 하므로, 담기 위한
/// 중간 자산(랙·함체)이 필요 없다. OFD 도 「경로슬롯 4장이 놓인 형판」이면 된다.
model AssemblyItem {
  id           String         @id @default(uuid())
  assemblyId   String
  assembly     Assembly       @relation(fields: [assemblyId], references: [id], onDelete: Cascade)
  typeId       String
  type         AssetType      @relation(fields: [typeId], references: [id])
  /// 만들어질 자산의 이름.
  name         String
  col          Int?
  row          Int?
  colSpan      Int?
  rowSpan      Int?
  /// 포트 수·심선 수 오버라이드 — 12심 판과 24심 판이 같은 타입일 수 있다.
  portCounts    Json          @default("{}")
  portPositions Json          @default("{}")
  sortOrder    Int            @default(0)
}

// ---------- 케이블 카탈로그 ----------

model CableGroup {
  id                String          @id @default(uuid())
  key               String          @unique
  name              String
  color             String
  laborType         String?
  installHoursPerM  Float           @default(0)
  removeHoursPerM   Float           @default(0)
  sortOrder         Int             @default(0)
  categories        CableCategory[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model CableCategory {
  id        String     @id @default(uuid())
  name      String
  groupId   String
  group     CableGroup @relation(fields: [groupId], references: [id])
  sortOrder Int        @default(0)
  cables    Cable[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([groupId, name])
}

// ---------- 인스턴스 ----------

model Asset {
  id            String      @id @default(uuid())
  name          String
  /// 부품이면 그 부품의 타입. **설비(형판으로 놓은 것)는 타입이 없다** — 분류는 형판이다.
  typeId        String?
  type          AssetType?  @relation(fields: [typeId], references: [id])
  substationId  String
  substation    Substation  @relation(fields: [substationId], references: [id])
  status        String      @default("normal")
  // 위치 A: 평면도 배치
  floorId       String?
  floor         Floor?      @relation(fields: [floorId], references: [id])
  x             Float?
  y             Float?
  width         Float?
  height        Float?
  // 위치 B: 설비 격자 안의 자리
  parentAssetId String?
  parentAsset   Asset?      @relation("AssetChildren", fields: [parentAssetId], references: [id], onDelete: Restrict)
  children      Asset[]     @relation("AssetChildren")
  /// 이 설비가 어느 형판으로 만들어졌는가 — **분류**다. 형판의 뿌리 자산에만 적힌다.
  ///
  /// 이름을 글자로 굳히지 않고 형판을 계속 가리킨다: 형판 이름을 고치면 이미 놓인 설비의
  /// 분류 표시도 따라 바뀌어야 한다(같은 형판이니까). 글자로 굳혀 두면 이름을 고치는 순간
  /// 같은 형판인데 집계가 둘로 갈린다.
  ///
  /// **구성은 스냅샷, 분류는 참조**다 — 형판을 고쳐도 이미 놓인 설비의 안쪽 구성은 그대로고
  /// 사용자가 언제든 그 설비만 따로 고칠 수 있다.
  assemblyId    String?
  assembly      Assembly? @relation(fields: [assemblyId], references: [id])
  /// 함체 격자에서의 자리(0-based). 자리 번호는 저장하지 않고 격자에서 유도한다.
  col           Int?
  row           Int?
  colSpan       Int?
  rowSpan       Int?
  // 커스텀 필드 값 { [fieldKey]: value }
  fieldValues   Json        @default("{}")
  ports         Port[]
  logs          MaintenanceLog[]
  inspections   InspectionLog[]
  photos        AssetPhoto[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([substationId])
  @@index([parentAssetId])
  @@index([floorId])

  // 카탈로그가 타입 편집/삭제 전 _count.assets 로 사용 중 여부를 센다.
  @@index([typeId])
}

model Port {
  id          String  @id @default(uuid())
  assetId     String
  asset       Asset   @relation(fields: [assetId], references: [id], onDelete: Cascade)
  group       String
  index       Int
  name        String
  direction   String // 'IN' | 'OUT' | 'BI'
  medium      String
  /// 이 포트 하나가 나르는 심선 수. 1 = 보통 포트, N = 다심 포트(OPGW 인입 한 가닥에 N심).
  /// 예전에는 그 N심을 포트 N개 + 케이블 N본으로 폈고, 그래서 설계서 공량이 심선 수만큼
  /// 부풀었다(40m 한 가닥 → 160m). 케이블은 1본이고 코어는 여기서 센다.
  positions   Int     @default(1)
  /// 이 포트에 딸린 값 — 광 심선의 손실(dB)·점검일처럼 **심선마다 다른** 것.
  /// 다심 포트에서는 코어 번호를 키로 한 겹 중첩된다: `{ "1": { lossDb: 0.6 }, … }`.
  fieldValues Json    @default("{}")
  cablesA     Cable[] @relation("CableA")
  cablesB     Cable[] @relation("CableB")

  @@unique([assetId, group, index])
  @@index([assetId])
}

model Cable {
  id           String         @id @default(uuid())
  name         String?
  substationId String
  substation   Substation     @relation(fields: [substationId], references: [id])
  aPortId      String
  aPort        Port           @relation("CableA", fields: [aPortId], references: [id])
  bPortId      String
  bPort        Port           @relation("CableB", fields: [bPortId], references: [id])
  categoryId   String?
  category     CableCategory? @relation(fields: [categoryId], references: [id])
  pathPoints   Json           @default("[]")
  specParams   Json           @default("{}")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([substationId])
  @@index([aPortId])
  @@index([bPortId])
}

// ---------- 이력 (타입 무관 제네릭 — 구 모델 유지) ----------

model MaintenanceLog {
  id         String   @id @default(uuid())
  assetId    String
  asset      Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  occurredAt DateTime
  content    String
  action     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // 자산 cascade 삭제와 워킹카피 조인이 이 컬럼을 탄다.
  // Postgres 는 FK 에 인덱스를 자동 생성하지 않아, 없으면 부모 1행 삭제마다 전체 스캔.
  @@index([assetId])
}

model InspectionLog {
  id          String   @id @default(uuid())
  assetId     String
  asset       Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  inspectedAt DateTime
  content     String
  result      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // 자산 cascade 삭제와 워킹카피 조인이 이 컬럼을 탄다.
  // Postgres 는 FK 에 인덱스를 자동 생성하지 않아, 없으면 부모 1행 삭제마다 전체 스캔.
  @@index([assetId])
}

model AssetPhoto {
  id        String   @id @default(uuid())
  assetId   String
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  filePath  String
  caption   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 자산 cascade 삭제와 워킹카피 조인이 이 컬럼을 탄다.
  // Postgres 는 FK 에 인덱스를 자동 생성하지 않아, 없으면 부모 1행 삭제마다 전체 스캔.
  @@index([assetId])
}
